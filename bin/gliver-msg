#!/usr/bin/env guile
!#
;;; bin/gliver-msg --- IPC client for Gliver
;;;
;;; Copyright (C) 2026 Gliver Contributors
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;;
;;; Usage:
;;;   gliver-msg <command> [args...]
;;;   gliver-msg eval '(expression)'
;;;
;;; Examples:
;;;   gliver-msg vsplit
;;;   gliver-msg exec firefox
;;;   gliver-msg gselect web
;;;   gliver-msg eval '(window-title (window-current))'
;;;   gliver-msg prefix-activated

(use-modules (ice-9 format)
             (ice-9 rdelim)
             (ice-9 textual-ports))

(define (ipc-socket-path)
  (let ((runtime-dir (or (getenv "XDG_RUNTIME_DIR")
                         (string-append "/run/user/"
                                        (number->string (getuid))))))
    (string-append runtime-dir "/gliver/ipc.sock")))

(define (send-command socket-path message)
  "Connect to the IPC socket, send MESSAGE, read response."
  (catch #t
    (lambda ()
      (let ((sock (socket AF_UNIX SOCK_STREAM 0)))
        (connect sock AF_UNIX socket-path)
        ;; Send message
        (display message sock)
        (newline sock)
        (force-output sock)
        ;; Read response
        (let ((response (read-line sock)))
          (close-port sock)
          (if (eof-object? response)
              "(error \"No response\")"
              response))))
    (lambda (key . args)
      (format (current-error-port)
              "gliver-msg: error: ~a ~a~%"
              key args)
      (format (current-error-port)
              "Is Gliver running? Socket: ~a~%"
              socket-path)
      (exit 1))))

(define (format-args args)
  "Format command-line arguments into an IPC message."
  (cond
   ((null? args)
    (format (current-error-port)
            "Usage: gliver-msg <command> [args...]~%")
    (exit 1))
   ;; Special case: eval passes the expression as-is
   ((string=? (car args) "eval")
    (if (null? (cdr args))
        (begin
          (format (current-error-port)
                  "Usage: gliver-msg eval '<expression>'~%")
          (exit 1))
        (format #f "(eval ~a)" (cadr args))))
   ;; Special case: exec joins all remaining args
   ((string=? (car args) "exec")
    (format #f "(exec ~s)" (string-join (cdr args) " ")))
   ;; Single command
   ((null? (cdr args))
    (car args))
   ;; Command with arguments
   (else
    (format #f "(~a ~a)"
            (car args)
            (string-join (map (lambda (a)
                                (if (string->number a)
                                    a
                                    (format #f "~s" a)))
                              (cdr args))
                         " ")))))

(define (parse-response response)
  "Parse and display the IPC response."
  (cond
   ((string-prefix? "(ok " response)
    ;; Success — print the result value
    (let ((value (substring response 4 (1- (string-length response)))))
      (unless (or (string=? value "#t")
                  (string=? value "#<unspecified>"))
        (display value)
        (newline))
      0))
   ((string-prefix? "(error " response)
    ;; Error — print to stderr
    (let ((msg (substring response 7 (1- (string-length response)))))
      (format (current-error-port) "gliver-msg: ~a~%" msg)
      1))
   (else
    ;; Unknown format — print as-is
    (display response)
    (newline)
    0)))

;;; ---- Main ----

(let* ((args (cdr (command-line)))
       (socket-path (or (getenv "GLIVER_IPC_SOCKET")
                        (ipc-socket-path)))
       (message (format-args args))
       (response (send-command socket-path message))
       (exit-code (parse-response response)))
  (exit exit-code))
