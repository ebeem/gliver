#!/usr/bin/guile \
-s
!#

;;; bin/gliver --- Main entry point for Gliver
;;;
;;; Copyright (C) 2026 Gliver Contributors
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;;
;;; Usage:
;;;   gliver [OPTIONS]
;;;
;;; Options:
;;;   --config PATH       Use a custom config file
;;;   --repl-socket PATH  Custom REPL socket path
;;;   --ipc-socket PATH   Custom IPC socket path
;;;   --log-level LEVEL   Set log level (debug, info, warn, error)
;;;   --replace           Replace a running instance
;;;   --version           Show version and exit
;;;   --help              Show help and exit

(use-modules (ice-9 format)
             (ice-9 getopt-long)
             (ice-9 match)
             (gliver core)
             (gliver river)
             (gliver contrib commands)
             (gliver river connector)
             (gliver river window-manager)
             (gliver river keybindings-manager)
             (gliver river layer-shell-manager)
			 (gliver contrib keybindings stumpwm)
			 (gliver contrib debug ipc-server)
             (gliver contrib debug repl-server)
)

(define *version* "0.0.3")

;;; cli argument parsing
(define option-spec
  '((config      (single-char #\c) (value #t))
    (repl-socket (value #t))
    (ipc-socket  (value #t))
    (log-level   (single-char #\l) (value #t))
    (replace     (single-char #\r) (value #f))
    (version     (single-char #\v) (value #f))
    (help        (single-char #\h) (value #f))))

(define (show-help)
  (format #t "Gliver ~a — A StumpWM-inspired Wayland window manager~%~%" *version*)
  (format #t "Usage: gliver [OPTIONS]~%~%")
  (format #t "Options:~%")
  (format #t "  -c, --config PATH        Custom config file path~%")
  (format #t "      --repl-socket PATH   Custom REPL socket path~%")
  (format #t "      --ipc-socket PATH    Custom IPC socket path~%")
  (format #t "  -l, --log-level LEVEL    Log level: debug, info, warn, error~%")
  (format #t "  -r, --replace            Replace a running instance~%")
  (format #t "  -v, --version            Show version~%")
  (format #t "  -h, --help               Show this help~%"))

;;; startup sequence
(define (startup! options)
  "Main startup sequence, following the spec §20.1."
  ;; step 1: parse cli arguments (already done)
  (let ((log-level (option-ref options 'log-level "debug"))
        (config-path (option-ref options 'config #f)))

    ;; step 2: initialize logging
    (for-each
      (lambda (dir)
        (unless (file-exists? dir)
          (mkdir dir)))
      (list *gliver-config-dir* *gliver-runtime-dir* *gliver-state-dir*))
    (log-level-set! (string->symbol log-level))
    (log-file-set! (string-append *gliver-state-dir* "/gliver.log"))
    (log-info "Gliver ~a starting..." *version*)
    (log-info "PID: ~a" (getpid))

    ;; step 3: connect to wayland display
    (log-info "Connecting to River...")
    (river-connect!)

    (unless (river-connected?)
      (log-error "Could not connect to Wayland display.")
      (log-error "Make sure River is running and WAYLAND_DISPLAY is set.")
      (format (current-error-port)
              "gliver: fatal: cannot connect to Wayland display~%")
      (exit 1))

    ;; step 4-5: protocol binding and output enumeration
    ;; handled inside river-connect! now

    ;; step 6: create default workspaces
    ;; create default output if none were detected via protocol
    ;; (when (null? (manager-outputs *manager*))
    ;;   (log-info "No outputs detected yet, creating default output.")
    ;;   (let ((output (make-output "default" #:width 1920 #:height 1080)))
    ;;     (output-add! output)))

    ;; step 7: layout registration
    ;; in river 0.4.1, the wm registers by binding river_window_manager_v1.
    ;; layout namespace is set when binding river_layout_manager_v3.
    ;; (log-info "Window manager protocol bound.")

    ;; step 8: start repl server
    (log-info "Starting REPL server...")
    (repl-start!)

    ;; step 9: start ipc server
    (log-info "Starting IPC server...")
    (ipc-start!)

    ;; step 10: install default keybindings (if not overridden by config)
    (keybindings-stumpwm-install-default!)

    ;; step 11: sync keybindings to river (deferred to next manage sequence)
    (log-info "requesting keybinding sync...")
    (gliver-hook-run! *keybinding-sync-request-hook*)

    ;; step 12: load configuration
    (log-info "Loading configuration...")
    (when config-path
      (set! *config-file-path* config-path))
    (config-load!)

    ;; step 13: border configuration
    ;; in river 0.4.1, borders are applied per-window during render sequences
    ;; via river_window_v1.set_borders. the display's border-width and
    ;; border-color values are read at render time by apply-border-config-to-window!
    (log-info "Border config: width=~a focused=~a unfocused=~a"
              (manager-config-ref 'border-width)
              (manager-config-ref 'border-color-focused)
              (manager-config-ref 'border-color-unfocused))

    (log-info "Running startup hooks...")
    (gliver-hook-run! *startup-hook*)

	;; NOTE: this should be calling the message module so it's visible
	;; inside the window manager, it should probably be moved to a module
    ;; show startup message
    (when *startup-message*
      (log-info "Welcome to Gliver ~a. Press C-t ? for help." *version*))

    (log-info "Startup complete.")))

(define (shutdown!)
  "Clean shutdown sequence."
  (log-info "Shutting down...")

  (gliver-hook-run! *shutdown-hook*)

  ;; stop servers
  (catch #t (lambda () (ipc-stop!)) (lambda _ #f))
  (catch #t (lambda () (repl-stop!)) (lambda _ #f))

  ;; disconnect from river
  (catch #t (lambda () (river-disconnect!)) (lambda _ #f))

  (log-info "Goodbye."))

(define (install-signal-handlers!)
  (define (handler sig)
    (log-info "Received OS signal ~a, forcing shutdown..." sig)
    ;; run shutdown safely
    (catch #t 
      (lambda () (shutdown!)) 
      (lambda _ #f))
    (exit (+ 128 sig)))

  (for-each (lambda (sig)
              (sigaction sig handler))
            (list SIGINT   ;; ctrl+c
                  SIGTERM  ;; standard 'kill' command
                  SIGHUP   ;; terminal closed / disconnected
                  SIGQUIT))) ;; ctrl+\

(define (main args)
  (let ((options (getopt-long args option-spec)))

    ;; --version
    (when (option-ref options 'version #f)
      (format #t "Gliver ~a~%" *version*)
      (exit 0))

    ;; --help
    (when (option-ref options 'help #f)
      (show-help)
      (exit 0))

	;; signal handlers to guarantee shutdown
    (install-signal-handlers!)
	
    ;; run
    (catch #t
      (lambda ()
        (startup! options)

        ;; step 16: enter main event loop
        (river-event-loop!)

		;; ensure proper shutdown if loop finishes
        (shutdown!))

      (lambda (key . args)
        (log-error "Fatal error: ~a ~a" key args)
        (format (current-error-port)
                "gliver: fatal error: ~a ~a~%" key args)
        (catch #t (lambda () (shutdown!)) (lambda _ #f))
        (exit 1)))))

;; entry point
(main (command-line))
