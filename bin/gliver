#!/usr/bin/env guile
!#

;;; bin/gliver --- Main entry point for Gliver
;;;
;;; Copyright (C) 2026 Gliver Contributors
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;;
;;; Usage:
;;;   gliver [OPTIONS]
;;;
;;; Options:
;;;   --config PATH       Use a custom config file
;;;   --repl-socket PATH  Custom REPL socket path
;;;   --ipc-socket PATH   Custom IPC socket path
;;;   --log-level LEVEL   Set log level (debug, info, warn, error)
;;;   --replace           Replace a running instance
;;;   --version           Show version and exit
;;;   --help              Show help and exit

(use-modules (ice-9 format)
             (ice-9 getopt-long)
             (ice-9 match)
             (srfi srfi-2)
             (gliver config)
             (gliver core)
             (gliver river)
             (gliver contrib commands)
             (gliver contrib keybindings gliver)
             (gliver contrib utils systemd)
             (gliver contrib debug ipc-server)
             (gliver contrib debug repl-server))

(define *version* "0.0.5")
(add-to-load-path %gliver-source-directory)
(set! %load-compiled-path
      (cons %gliver-compiled-directory %load-compiled-path))

;;; cli argument parsing
(define option-spec
  '((config      (single-char #\c) (value #t))
    (repl-socket (value #t))
    (ipc-socket  (value #t))
    (log-level   (single-char #\l) (value #t))
    (replace     (single-char #\r) (value #f))
    (version     (single-char #\v) (value #f))
    (help        (single-char #\h) (value #f))))

(define (show-help)
  (format #t "Gliver ~a — A StumpWM-inspired Wayland window manager~%~%" *version*)
  (format #t "Usage: gliver [OPTIONS]~%~%")
  (format #t "Options:~%")
  (format #t "  -c, --config PATH        Custom config file path~%")
  (format #t "      --repl-socket PATH   Custom REPL socket path~%")
  (format #t "      --ipc-socket PATH    Custom IPC socket path~%")
  (format #t "  -l, --log-level LEVEL    Log level: debug, info, warn, error~%")
  (format #t "  -r, --replace            Replace a running instance~%")
  (format #t "  -v, --version            Show version~%")
  (format #t "  -h, --help               Show this help~%"))

(define (mkdir-p path)
  "Create directory PATH and any missing parent directories."
  (unless (file-exists? path)
    (let ((parent (dirname path)))
      (when (and (not (string=? parent path))
                 (not (file-exists? parent)))
        (mkdir-p parent)))
    (mkdir path)))

(define (log-session-environment phase)
  "Log key session environment variables at PHASE for debugging."
  (log-info "Session environment (~a): XDG_SESSION_TYPE=~s XDG_CURRENT_DESKTOP=~s WAYLAND_DISPLAY=~s DBUS_SESSION_BUS_ADDRESS=~s"
            phase
            (getenv "XDG_SESSION_TYPE")
            (getenv "XDG_CURRENT_DESKTOP")
            (getenv "WAYLAND_DISPLAY")
            (getenv "DBUS_SESSION_BUS_ADDRESS")))

(define (executable-exists? name)
  "Return #t if executable NAME is found in PATH."
  (and-let* ((path (getenv "PATH"))
             (bin (search-path (string-split path #\:) name)))
    (access? bin X_OK)))

(define (ensure-session-environment!)
  "Ensure XDG session environment variables are set to proper values."
  (let ((session-type    (getenv "XDG_SESSION_TYPE"))
        (current-desktop (getenv "XDG_CURRENT_DESKTOP")))
    (cond
     ;; if XDG_SESSION_TYPE is empty in environment variables
     ;; set it to "wayland"
     ((or (not session-type)
          (string-null? session-type))
      (setenv "XDG_SESSION_TYPE" "wayland"))
     ;; if XDG_SESSION_TYPE has a value other than "wayland"
     ;; leave it put warn user as this may cause compatibility issues
     ((not (string=? session-type "wayland"))
      (log-warn "XDG_SESSION_TYPE is ~s (expected \"wayland\"); this may cause issues."
                session-type)))

    (cond
     ;; if XDG_CURRENT_DESKTOP is empty in environment variables
     ;; set it to "gliver:river:wlr" (fallback gliver -> river -> wlr)
     ((or (not current-desktop) (string-null? current-desktop))
      (setenv "XDG_CURRENT_DESKTOP" "gliver:river:wlr"))
     ;; if it's set to something else that doesn't contain wlr
     ;; leave it but warn user
     ((not (member "wlr" (string-split current-desktop #\:)))
      (log-warn "XDG_CURRENT_DESKTOP is ~s (missing \"wlr\" fallback); this may cause issues."
                current-desktop)))))

(define (update-activation-environment!)
  "Export session environment variables to D-Bus and systemd when available."
  (and-let* ((dbus-addr (getenv "DBUS_SESSION_BUS_ADDRESS"))
             ((not (string-null? dbus-addr)))
             ;; I believe there should be no distro missing this binary
             ((executable-exists? "dbus-update-activation-environment")))
    (let* ((systemd-dbus? (and (executable-exists? "systemctl")
                               (systemd-active? "dbus.service")))
           (args (if systemd-dbus?
                     ;; for systemd, we have to pass --systemd to dbus
                     '("--systemd" "--all")
                     '("--all")))
           (status (apply system* "dbus-update-activation-environment" args))
           (rc (status:exit-val status)))
      (unless (and rc (zero? rc))
        (log-warn "dbus-update-activation-environment exited with status ~a" rc)))))

;;; startup sequence
(define (startup! options)
  "Main startup sequence, following the spec §20.1."
  ;; step 1: parse cli arguments (already done)
  (let ((log-level (option-ref options 'log-level "debug"))
        (config-path (option-ref options 'config #f)))

    ;; step 2: initialize logging
    (for-each mkdir-p
			  (list *gliver-config-dir* *gliver-runtime-dir* *gliver-state-dir*))
    (log-level-set! (string->symbol log-level))
    (log-file-set! (string-append *gliver-state-dir* "/gliver.log"))
    (log-info "Gliver ~a starting..." *version*)
    (log-info "PID: ~a" (getpid))

    ;; step 3: connect to wayland display
    (log-info "Connecting to River...")
    (river-connect!)

    (unless *river-connected?*
      (log-error "Could not connect to Wayland display.")
      (log-error "Make sure River is running and WAYLAND_DISPLAY is set.")
      (format (current-error-port)
              "gliver: fatal: cannot connect to Wayland display~%")
      (exit 1))

    ;; step 4: start repl and ipc servers
    (log-info "Starting REPL server...")
    (repl-start!)
    (log-info "Starting IPC server...")
    (ipc-start!)

    ;; step 5: install default keybindings (default, can be overridden)
    (keybindings-gliver-install-default!)

    ;; step 6: update environment variables
    ;; details: https://codeberg.org/ebeem/gliver/issues/38
    (log-session-environment "before")
    (ensure-session-environment!)
    (update-activation-environment!)
    (log-session-environment "after")

	;; step 7: startup hook & load configuration
    ;; show startup message
    (when *startup-message*
      (log-info "Welcome to Gliver ~a. Press C-t ? for help." *version*))

    (log-info "Running startup hooks...")
    (gliver-hook-run! *startup-hook*)

    (log-info "Loading configuration...")
    (when config-path
      (set! *config-file-path* config-path))
	(with-manage-sequence
     (config-load!))))

(define (shutdown!)
  "Clean shutdown sequence."
  (log-info "Shutting down...")

  (catch #t (lambda () (gliver-hook-run! *shutdown-hook*)) (lambda _ #f))

  ;; stop servers
  (catch #t (lambda () (ipc-stop!)) (lambda _ #f))
  (catch #t (lambda () (repl-stop!)) (lambda _ #f))

  ;; disconnect from river
  (catch #t (lambda () (river-disconnect!)) (lambda _ #f))

  (log-info "Goodbye."))

(define (install-signal-handlers!)
  (define (handler sig)
    (log-info "Received OS signal ~a, forcing shutdown..." sig)
    ;; run shutdown safely
    (catch #t
      (lambda () (shutdown!))
      (lambda _ #f))
    (exit (+ 128 sig)))

  (for-each (lambda (sig)
              (sigaction sig handler))
            (list SIGINT   ;; ctrl+c
                  SIGTERM  ;; standard 'kill' command
                  SIGHUP   ;; terminal closed / disconnected
                  SIGQUIT))) ;; ctrl+\

(define (main args)
  (let ((options (getopt-long args option-spec)))

    ;; --version
    (when (option-ref options 'version #f)
      (format #t "Gliver ~a~%" *version*)
      (exit 0))

    ;; --help
    (when (option-ref options 'help #f)
      (show-help)
      (exit 0))

	;; signal handlers to guarantee shutdown
    (install-signal-handlers!)

    ;; run
    (catch #t
      (lambda ()
        (startup! options)

        ;; step 16: enter main event loop
        (river-event-loop!)

		;; ensure proper shutdown if loop finishes
        (shutdown!)
		(exit 0))

      (lambda (key . args)
        (log-error "Fatal error: ~a ~a" key args)
        (format (current-error-port)
                "gliver: fatal error: ~a ~a~%" key args)
        (catch #t (lambda () (shutdown!)) (lambda _ #f))
        (exit 1)))))

;; entry point
(main (command-line))
