#!/usr/bin/guile \
-s
!#

;;; gliver-placeholder --- Minimal Wayland window placeholder
(use-modules (system foreign)
             (rnrs bytevectors)
             (gliver wayland client)
             (gliver wayland gen wayland)
             (gliver wayland gen xdg-shell))

(define *background-color* #x800c0d13) ;; premultiplied argb8888
(define *mfd-cloexec* 1)
(define *prot-read-write* 3)
(define *map-shared* 1)

;;; libc ffi helpers
;;; NOTE: libc should already be loaded
(define libc (dynamic-link))
(define memfd-create
  (pointer->procedure int (dynamic-func "memfd_create" libc) (list '* uint32)))
(define ftruncate
  (pointer->procedure int (dynamic-func "ftruncate" libc) (list int int64)))
(define close-fd
  (pointer->procedure int (dynamic-func "close" libc) (list int)))
(define mmap
  (pointer->procedure '* (dynamic-func "mmap" libc) (list '* size_t int int int int64)))
(define munmap
  (pointer->procedure int (dynamic-func "munmap" libc) (list '* size_t)))

(define %null-pointer (make-pointer 0))

;;; wayland state
(define display (wl-display-connect))
(define compositor %null-pointer)
(define shm %null-pointer)
(define xdg-wm-base %null-pointer)

(define win-width 640)
(define win-height 480)
(define current-buffer %null-pointer)
(define configured? #f)
(define running? #t)

(define registry-listener
  (make-wl-listener
   (list
    (procedure->pointer void
      (lambda (data reg id proto ver)
        (let ((name (pointer->string proto)))
          (cond
           ((string=? name "wl_compositor")
            (set! compositor (gliver-wl-registry-bind reg id *wl-compositor-interface* (min ver 4))))
           ((string=? name "wl_shm")
            (set! shm (gliver-wl-registry-bind reg id *wl-shm-interface* 1)))
           ((string=? name "xdg_wm_base")
            (set! xdg-wm-base (gliver-wl-registry-bind reg id *xdg-wm-base-interface* 1))))))
      (list '* '* uint32 '* uint32))
    (procedure->pointer void (lambda _ #f) (list '* '* uint32)))))

(define registry (gliver-wl-display-get-registry display))
(wl-proxy-add-listener registry registry-listener %null-pointer)
(wl-display-roundtrip display)

(define surface (wl-compositor-create-surface compositor))

(define wm-base-listener
  (make-xdg-wm-base-listener
   (lambda (data wm serial)
     (xdg-wm-base-pong wm serial))))

(wl-proxy-add-listener xdg-wm-base wm-base-listener %null-pointer)

(define xdg-surface (xdg-wm-base-get-xdg-surface xdg-wm-base surface))
(define xdg-toplevel (xdg-surface-get-toplevel xdg-surface))

(define (recreate-buffer! w h)
  (when (and (> w 0) (> h 0))
    (let* ((stride (* w 4))
           (size (* stride h))
           (fd (memfd-create (string->pointer "wl-shm-buffer") *mfd-cloexec*)))
      (when (>= fd 0)
        (ftruncate fd size)

        ;; map memory and populate pixel buffer
        (let ((ptr (mmap %null-pointer size *prot-read-write* *map-shared* fd 0)))
          (unless (null-pointer? ptr)
            (let ((bv (pointer->bytevector ptr size)))
              (do ((offset 0 (+ offset 4)))
                  ((>= offset size))
                (bytevector-u32-native-set! bv offset *background-color*)))
            (munmap ptr size)))

        ;; create shm pool & buffer, then destroy pool immediately
        (let ((pool (wl-shm-create-pool shm fd size)))
          (unless (null-pointer? current-buffer)
            (wl-buffer-destroy current-buffer))
          (set! current-buffer (wl-shm-pool-create-buffer pool 0 w h stride WL_SHM_FORMAT_ARGB8888))
          (wl-shm-pool-destroy pool))

        (close-fd fd)

        ;; attach and commit new buffer
        (wl-surface-attach surface current-buffer 0 0)
        (wl-surface-damage surface 0 0 w h)
        (wl-surface-commit surface)))))

(define toplevel-listener
  (make-xdg-toplevel-listener
   (lambda (data toplevel width height states)
     (when (and (> width 0) (> height 0))
       (set! win-width width)
       (set! win-height height)))
   (lambda _ (set! running? #f))
   (lambda _ #f)
   (lambda _ #f)))

(define surface-listener
  (make-xdg-surface-listener
   (lambda (data surf serial)
     (xdg-surface-ack-configure surf serial)
     (set! configured? #t)
     (recreate-buffer! win-width win-height))))

(wl-proxy-add-listener xdg-toplevel toplevel-listener %null-pointer)
(wl-proxy-add-listener xdg-surface surface-listener %null-pointer)

(xdg-toplevel-set-title xdg-toplevel "gliver-placeholder")
(xdg-toplevel-set-app-id xdg-toplevel "gliver-placeholder")

(wl-surface-commit surface)
(while (not configured?)
  (wl-display-dispatch display))

;;; main event loop
(while running?
  (when (< (wl-display-dispatch display) 0)
    (set! running? #f)))

;; cleanup
(unless (null-pointer? current-buffer)
  (wl-buffer-destroy current-buffer))
(wl-display-disconnect display)
