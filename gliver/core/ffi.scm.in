;;; gliver/core/ffi.scm.in --- Shared library paths for foreign function interfaces
;;;
;;; Copyright (C) 2026 Gliver Contributors
;;; SPDX-License-Identifier: GPL-3.0-or-later
;;;
;;; This module defines paths to dynamically loaded shared libraries
;;; used by Gliver via Guile's Foreign Function Interface (FFI).
;;;
;;; Any used library must be referenced here and in Makefile so
;;; they can be resolved in any system, this approach also ensures
;;; proper support for Guix, check the below pull request for details
;;; https://codeberg.org/ebeem/gliver/pulls/3

(define-module (gliver core ffi)
  #:declarative? #f
  #:export (
			%libxkbcommon
			%libwayland-client
			%libpango
			%libpangocairo
			%libgobject
			%librsvg
))

;;; shared library paths
(define %libxkbcommon
  "@LIBXKBCOMMON_LIBDIR@/libxkbcommon")

(define %libwayland-client
  "@LIBWAYLAND_CLIENT_LIBDIR@/libwayland-client")

(define %libpango
  "@LIBPANGO_LIBDIR@/libpango-1.0")

(define %libpangocairo
  "@LIBPANGOCAIRO_LIBDIR@/libpangocairo-1.0")

(define %libgobject
  "@LIBGOBJECT_LIBDIR@/libgobject-2.0")

(define %librsvg
  "@LIBRSVG_LIBDIR@/librsvg-2")
