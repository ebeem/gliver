;;; wl_subsurface requests

;;; destroy: opcode 0 (destructor)
(define (wl-subsurface-destroy proxy)
  "remove sub-surface interface"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; set_position: opcode 1
(define (wl-subsurface-set-position proxy x y)
  "reposition the sub-surface"
  (wl-marshal-request proxy 1
    (list (cons 'int x) (cons 'int y))))

;;; place_above: opcode 2
(define (wl-subsurface-place-above proxy sibling)
  "restack the sub-surface"
  (wl-marshal-request proxy 2
    (list (cons 'object sibling))))

;;; place_below: opcode 3
(define (wl-subsurface-place-below proxy sibling)
  "restack the sub-surface"
  (wl-marshal-request proxy 3
    (list (cons 'object sibling))))

;;; set_sync: opcode 4
(define (wl-subsurface-set-sync proxy)
  "set sub-surface to synchronized mode"
  (wl-marshal-request proxy 4 '()))

;;; set_desync: opcode 5
(define (wl-subsurface-set-desync proxy)
  "set sub-surface to desynchronized mode"
  (wl-marshal-request proxy 5 '()))

;;; wl_subcompositor requests

;;; destroy: opcode 0 (destructor)
(define (wl-subcompositor-destroy proxy)
  "unbind from the subcompositor interface"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; get_subsurface: opcode 1 (constructor)
(define (wl-subcompositor-get-subsurface proxy surface parent)
  "give a surface the role sub-surface"
  (wl-marshal-constructor proxy 1
    *wl-subsurface-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0) (cons 'object surface) (cons 'object parent))))

;;; wl_fixes requests

;;; destroy: opcode 0 (destructor)
(define (wl-fixes-destroy proxy)
  "destroys this object"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; destroy_registry: opcode 1
(define (wl-fixes-destroy-registry proxy registry)
  "destroy a wl_registry"
  (wl-marshal-request proxy 1
    (list (cons 'object registry))))

;;; ack_global_remove: opcode 2
(define (wl-fixes-ack-global-remove proxy registry name)
  "acknowledge global removal"
  (wl-marshal-request proxy 2
    (list (cons 'object registry) (cons 'uint name))))

