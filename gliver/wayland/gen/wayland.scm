;;; requests, event handlers, and listeners
;;; wl_callback event handlers
(define *wl-callback-done-handler* #f)

(define (set-wl-callback-done-handler! handler)
  "Set the handler for done events."
  (set! *wl-callback-done-handler* handler))

;;; wl_callback listener
(define (make-wl-callback-listener on-done)
  "Create a listener for wl_callback events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-done (list '* '* uint32))
   )))

;;; wl_registry requests

;;; bind: opcode 0 (constructor)
(define (wl-registry-bind proxy name)
  "bind an object to the display"
  (wl-marshal-constructor proxy 0
    %null-pointer
    (wl-proxy-get-version proxy)
    (list (cons 'uint name) (cons 'new-id 0))))

;;; wl_registry event handlers
(define *wl-registry-global-handler* #f)
(define *wl-registry-global-remove-handler* #f)

(define (set-wl-registry-global-handler! handler)
  "Set the handler for global events."
  (set! *wl-registry-global-handler* handler))

(define (set-wl-registry-global-remove-handler! handler)
  "Set the handler for global_remove events."
  (set! *wl-registry-global-remove-handler* handler))

;;; wl_registry listener
(define (make-wl-registry-listener on-global
                                   on-global-remove)
  "Create a listener for wl_registry events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-global (list '* '* uint32 '* uint32))
    (procedure->pointer void on-global-remove (list '* '* uint32))
   )))

;;; wl_display requests

;;; sync: opcode 0 (constructor)
(define (wl-display-sync proxy)
  "asynchronous roundtrip"
  (wl-marshal-constructor proxy 0
    *wl-callback-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0))))

;;; get_registry: opcode 1 (constructor)
(define (wl-display-get-registry proxy)
  "get global registry object"
  (wl-marshal-constructor proxy 1
    *wl-registry-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0))))

;;; wl_display event handlers
(define *wl-display-error-handler* #f)
(define *wl-display-delete-id-handler* #f)

(define (set-wl-display-error-handler! handler)
  "Set the handler for error events."
  (set! *wl-display-error-handler* handler))

(define (set-wl-display-delete-id-handler! handler)
  "Set the handler for delete_id events."
  (set! *wl-display-delete-id-handler* handler))

;;; wl_display listener
(define (make-wl-display-listener on-error
                                  on-delete-id)
  "Create a listener for wl_display events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-error (list '* '* '* uint32 '*))
    (procedure->pointer void on-delete-id (list '* '* uint32))
   )))

;;; wl_surface requests

;;; destroy: opcode 0 (destructor)
(define (wl-surface-destroy proxy)
  "delete surface"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; attach: opcode 1
(define (wl-surface-attach proxy buffer x y)
  "set the surface contents"
  (wl-marshal-request proxy 1
    (list (cons 'object buffer) (cons 'int x) (cons 'int y))))

;;; damage: opcode 2
(define (wl-surface-damage proxy x y width height)
  "mark part of the surface damaged"
  (wl-marshal-request proxy 2
    (list (cons 'int x) (cons 'int y) (cons 'int width) (cons 'int height))))

;;; frame: opcode 3 (constructor)
(define (wl-surface-frame proxy)
  "request a frame throttling hint"
  (wl-marshal-constructor proxy 3
    *wl-callback-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0))))

;;; set_opaque_region: opcode 4
(define (wl-surface-set-opaque-region proxy region)
  "set opaque region"
  (wl-marshal-request proxy 4
    (list (cons 'object region))))

;;; set_input_region: opcode 5
(define (wl-surface-set-input-region proxy region)
  "set input region"
  (wl-marshal-request proxy 5
    (list (cons 'object region))))

;;; commit: opcode 6
(define (wl-surface-commit proxy)
  "commit pending surface state"
  (wl-marshal-request proxy 6 '()))

;;; set_buffer_transform: opcode 7
(define (wl-surface-set-buffer-transform proxy transform)
  "sets the buffer transformation"
  (wl-marshal-request proxy 7
    (list (cons 'int transform))))

;;; set_buffer_scale: opcode 8
(define (wl-surface-set-buffer-scale proxy scale)
  "sets the buffer scaling factor"
  (wl-marshal-request proxy 8
    (list (cons 'int scale))))

;;; damage_buffer: opcode 9
(define (wl-surface-damage-buffer proxy x y width height)
  "mark part of the surface damaged using buffer coordinates"
  (wl-marshal-request proxy 9
    (list (cons 'int x) (cons 'int y) (cons 'int width) (cons 'int height))))

;;; offset: opcode 10
(define (wl-surface-offset proxy x y)
  "set the surface contents offset"
  (wl-marshal-request proxy 10
    (list (cons 'int x) (cons 'int y))))

;;; get_release: opcode 11 (constructor)
(define (wl-surface-get-release proxy)
  "get a release callback"
  (wl-marshal-constructor proxy 11
    *wl-callback-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0))))

;;; wl_surface event handlers
(define *wl-surface-enter-handler* #f)
(define *wl-surface-leave-handler* #f)
(define *wl-surface-preferred-buffer-scale-handler* #f)
(define *wl-surface-preferred-buffer-transform-handler* #f)

(define (set-wl-surface-enter-handler! handler)
  "Set the handler for enter events."
  (set! *wl-surface-enter-handler* handler))

(define (set-wl-surface-leave-handler! handler)
  "Set the handler for leave events."
  (set! *wl-surface-leave-handler* handler))

(define (set-wl-surface-preferred-buffer-scale-handler! handler)
  "Set the handler for preferred_buffer_scale events."
  (set! *wl-surface-preferred-buffer-scale-handler* handler))

(define (set-wl-surface-preferred-buffer-transform-handler! handler)
  "Set the handler for preferred_buffer_transform events."
  (set! *wl-surface-preferred-buffer-transform-handler* handler))

;;; wl_surface listener
(define (make-wl-surface-listener on-enter
                                  on-leave
                                  on-preferred-buffer-scale
                                  on-preferred-buffer-transform)
  "Create a listener for wl_surface events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-enter (list '* '* '*))
    (procedure->pointer void on-leave (list '* '* '*))
    (procedure->pointer void on-preferred-buffer-scale (list '* '* int32))
    (procedure->pointer void on-preferred-buffer-transform (list '* '* uint32))
   )))

;;; wl_region requests

;;; destroy: opcode 0 (destructor)
(define (wl-region-destroy proxy)
  "destroy region"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; add: opcode 1
(define (wl-region-add proxy x y width height)
  "add rectangle to region"
  (wl-marshal-request proxy 1
    (list (cons 'int x) (cons 'int y) (cons 'int width) (cons 'int height))))

;;; subtract: opcode 2
