;;; destroy: opcode 0 (destructor)
(define (xdg-wm-base-destroy proxy)
  "destroy xdg_wm_base"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 0)))

;;; create_positioner: opcode 1 (constructor)
(define (xdg-wm-base-create-positioner proxy)
  "create a positioner object"
  (wl-marshal-constructor proxy 1
    *xdg-positioner-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0))))

;;; get_xdg_surface: opcode 2 (constructor)
(define (xdg-wm-base-get-xdg-surface proxy surface)
  "create a shell surface from a surface"
  (wl-marshal-constructor proxy 2
    *xdg-surface-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0) (cons 'object surface))))

;;; pong: opcode 3
(define (xdg-wm-base-pong proxy serial)
  "respond to a ping event"
  (wl-marshal-request proxy 3
    (list (cons 'uint serial))))

;;; xdg_wm_base event handlers
(define *xdg-wm-base-ping-handler* #f)

(define (set-xdg-wm-base-ping-handler! handler)
  "Set the handler for ping events."
  (set! *xdg-wm-base-ping-handler* handler))

;;; xdg_wm_base listener
(define (make-xdg-wm-base-listener on-ping)
  "Create a listener for xdg_wm_base events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-ping (list '* '* uint32))
   )))

