;;; river_libinput_config_v1 requests

;;; stop: opcode 0
(define (river-libinput-config-v1-stop proxy)
  "stop sending events"
  (wl-marshal-request proxy 0 '()))

;;; destroy: opcode 1 (destructor)
(define (river-libinput-config-v1-destroy proxy)
  "destroy the river_libinput_config_v1 object"
  (unless (null-pointer? proxy)
    (wl-marshal-request-destroy proxy 1)))

;;; create_accel_config: opcode 2 (constructor)
(define (river-libinput-config-v1-create-accel-config proxy profile)
  "create a acceleration config"
  (wl-marshal-constructor proxy 2
    *river-libinput-accel-config-v1-interface*
    (wl-proxy-get-version proxy)
    (list (cons 'new-id 0) (cons 'uint profile))))

;;; river_libinput_config_v1 event handlers
(define *river-libinput-config-v1-finished-handler* #f)
(define *river-libinput-config-v1-libinput-device-handler* #f)

(define (set-river-libinput-config-v1-finished-handler! handler)
  "Set the handler for finished events."
  (set! *river-libinput-config-v1-finished-handler* handler))

(define (set-river-libinput-config-v1-libinput-device-handler! handler)
  "Set the handler for libinput_device events."
  (set! *river-libinput-config-v1-libinput-device-handler* handler))

;;; river_libinput_config_v1 listener
(define (make-river-libinput-config-v1-listener on-finished
                                                on-libinput-device)
  "Create a listener for river_libinput_config_v1 events.
Each callback receives (data proxy ...) arguments."
  (make-wl-listener
   (list
    (procedure->pointer void on-finished (list '* '*))
    (procedure->pointer void on-libinput-device (list '* '* '*))
   )))

